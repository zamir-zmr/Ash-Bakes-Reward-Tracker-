rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {
    // Login/Manager system app ke andar hai (Firebase Authentication use nahi hota),
    // isliye rules app ke collections ko open rakhte hain.
    match /users/{id}  { allow read, write: if true; }
    match /meta/{id}   { allow read, write: if true; }
    match /orders/{id} { allow read, write: if true; }
  }
}
