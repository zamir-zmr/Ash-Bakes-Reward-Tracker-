rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {

    function signedIn() { return request.auth != null; }
    function hasProfile() {
      return signedIn() && exists(/databases/$(db)/documents/users/$(request.auth.uid));
    }
    // admin = Manager, staff = User
    function isAdmin() {
      return hasProfile()
        && get(/databases/$(db)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // meta/admin = "pehla manager ban chuka hai" flag.
    // Login screen isse bina login ke padhta hai (First time setup dikhane ke liye).
    match /meta/{id} {
      allow read: if id == 'admin' || signedIn();
      allow create: if signedIn() && id == 'admin' && !exists(/databases/$(db)/documents/meta/admin);
      allow delete: if isAdmin();
    }

    // users: Manager kisi ko bhi add / remove kar sakta hai.
    // Self-signup band: sirf (1) pehla manager apna account bana sakta hai, (2) manager naye accounts.
    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow create: if isAdmin() || (
        signedIn() && request.auth.uid == uid &&
        request.resource.data.role == 'admin' &&
        !exists(/databases/$(db)/documents/meta/admin)
      );
      allow update: if isAdmin() || (signedIn() && request.auth.uid == uid && request.resource.data.role == resource.data.role);
      allow delete: if signedIn() && (request.auth.uid == uid || isAdmin());
    }

    // creds: Manager ko password change / account remove karne ke liye (sirf manager padh sakta hai)
    match /creds/{uid} {
      allow read: if isAdmin();
      allow write: if signedIn() && (request.auth.uid == uid || isAdmin());
    }

    // order: creator hi edit/delete kare, user sirf apne order dekhe, manager sab dekhe
    match /orders/{id} {
      allow read: if hasProfile() && (resource.data.get('creatorUid', null) == request.auth.uid || isAdmin());
      allow create: if hasProfile() && request.resource.data.creatorUid == request.auth.uid;
      allow update, delete: if hasProfile() && (
        resource.data.get('creatorUid', null) == request.auth.uid ||
        (isAdmin() && resource.data.get('creatorUid', null) == null)
      );
    }

    // purana staff collection (ab use nahi hota)
    match /staff/{id} { allow read: if isAdmin(); }
  }
}
